{
  "name": "travel-together---backend",
  "version": "1.0.0",
  "description": "Backend for the travel together application",
  "type": "commonjs",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "migrate:trips": "node server/scripts/migrateTrips.js",
    "db:validators": "node server/scripts/applyValidators.js",
    "format": "prettier --write \"server/**/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\"",
    "lint": "eslint server --fix",
    "prepare": "echo husky disabled",
    "test": "node --test server/tests/**/*.test.js",
    "smoke:api": "node server/scripts/smokeApi.js"
  },
  "keywords": [],
  "author": "Ritesh Bhosale",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.0",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^2.2.1",
    "nodemailer": "^8.0.7",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6",
    "@sentry/node": "^7.66.0",
    "prom-client": "^14.0.0"
  },
  "optionalDependencies": {
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0"
  }
}
