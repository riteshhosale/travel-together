{
  "annotations": {"list": []},
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Latency (P50/P95/P99)",
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(travel_together_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(travel_together_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, sum(rate(travel_together_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99"}
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Error Rate (5m)",
      "targets": [ {"expr": "sum(rate(http_server_errors_total[5m]))", "legendFormat": "errors/sec"} ],
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Process CPU (seconds)",
      "targets": [ { "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "cpu/sec" } ],
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Memory (RSS)",
      "targets": [ { "expr": "process_resident_memory_bytes", "legendFormat": "bytes" } ],
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 4 }
    }
  ],
  "title": "Travel Together Backend"
}
